{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "wxyclark/lafidemo",
    "type": "project",
    "description": "Laravel 13 + Filament multi-tenant ecommerce SaaS reference project",
    "keywords": [
        "laravel",
        "filament",
        "ecommerce",
        "saas",
        "o2o"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4.3",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-gd": "*",
        "ext-hash": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-redis": "*",
        "ext-session": "*",
        "ext-simplexml": "*",
        "ext-tokenizer": "*",
        "ext-xmlreader": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "brick/money": "^0.15",
        "chillerlan/php-qrcode": "^5.0",
        "filament/filament": "^5.0",
        "intervention/image": "^4.0",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.50",
        "laravel/sanctum": "^4.0",
        "openspout/openspout": "^4.23",
        "yansongda/pay": "^3.7.20"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.29",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse",
        "style": "vendor/bin/pint --test",
        "audit": "composer audit",
        "ci": [
            "@audit",
            "@style",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.3"
        },
        "platform-check": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
