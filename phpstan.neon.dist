includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest/extension.neon

parameters:
    level: 5
    paths:
        - app
        - database
        - tests
    ignoreErrors:
        # Dynamic Eloquent methods resolved at runtime on the bound model
        # (SoftDeletes::withTrashed).
        - identifier: method.notFound
          message: '#Illuminate\\Database\\Eloquent\\Model::withTrashed\(\)#'
        # Foreign key comment() is a Laravel version-specific schema API.
        - identifier: method.notFound
          message: '#Illuminate\\Database\\Schema\\ForeignKeyDefinition::comment\(\)#'
        # Eloquent models expose attributes dynamically via __get (larastan
        # cannot resolve model columns declared only in $fillable/casts).
        - identifier: property.notFound
          message: '#Illuminate\\Database\\Eloquent\\Model::\$#'
